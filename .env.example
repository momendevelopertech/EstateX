# Copy this file to .env.local and fill in the values
# The SRS docs (the .md files) stay in the repo root and do not affect the app.

# Neon PostgreSQL (serverless) — the pooled connection string
DATABASE_URL="postgresql://..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="djseokhow"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."
CLOUDINARY_URL="cloudinary://..."

# JWT secret for the admin login — generate with: openssl rand -base64 32
JWT_SECRET="change-me"
# Demo admin password used when seeding (change before going to production)
ADMIN_PASSWORD="Admin@123"